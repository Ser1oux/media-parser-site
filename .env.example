# ============ 访问口令（必填，前端进入时要输入） ============
ACCESS_TOKEN=change-me-to-a-long-random-string

# ============ 各平台 Cookie ============
# 获取方式：浏览器登录后 F12 → Network → 随便点一个该域名请求 → 复制请求头 Cookie 整串

# 抖音（建议）：douyin.com 登录后的 Cookie。用于提升解析成功率 + 注入无头浏览器兜底
DOUYIN_COOKIE=

# 小红书（建议）：xiaohongshu.com 登录后的 Cookie（含 web_session）。降低风控概率
XHS_COOKIE=

# X / Twitter（可选）：公开推文不需要；私密推文才要
X_COOKIE=

# YouTube（可选）：公开视频不需要；会员/年龄限制视频才要
YT_COOKIE=

# ============ 出口代理 ============
# 服务器在国内时：YouTube / X 必须配 PROXY_OVERSEAS（http://host:port）
# 服务器在海外时：抖音 / 小红书 建议配 PROXY_CN（住宅代理最佳，机房 IP 易被风控）
PROXY_CN=
PROXY_OVERSEAS=

# 解析结果内存缓存秒数（避免连点重复触发平台风控）
CACHE_TTL=600
